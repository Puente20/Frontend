SECRET_KEY=django-insecure-zentry-dev-key-change-in-production
DEBUG=True

# Si queres usar SQLite inicialmente para pruebas rapidas, deja USE_SQLITE=True
# Si queres usar PostgreSQL, cambia USE_SQLITE=False y completa los datos abajo:
USE_SQLITE=True

DB_ENGINE=django.db.backends.postgresql
DB_NAME=zentry_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Credenciales locales para configurar la cuenta administradora.
# Definilas en .env (no subas ese archivo al repositorio).
ZENTRY_ADMIN_EMAIL=administrador@gmail.com
ZENTRY_ADMIN_PASSWORD=contrasena123

# Credenciales para asignar acceso a un residente ya registrado.
ZENTRY_RESIDENT_EMAIL=
ZENTRY_RESIDENT_PASSWORD=
